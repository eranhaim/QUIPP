# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/quipp?retryWrites=true&w=majority

# URLs
CORS_ORIGIN=http://localhost:8080
APP_URL=http://localhost:8080

# Secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_at_least_32_characters_long_random_string
JWT_REFRESH_SECRET=change_me_another_32_characters_long_random_string
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# Set to "false" for initial HTTP-only deploy; "true" once HTTPS is live.
# Leave blank to default: true in production, false in dev.
COOKIE_SECURE=

# Optional in dev — leave blank and verification emails print to the terminal
RESEND_API_KEY=
EMAIL_FROM=QUIPP <noreply@quipp.co>

# Stripe course seat purchases.
# Leave keys blank in dev; paid checkout returns 503 while zero-price packs still work.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=cad

# AWS S3 for course video storage.
# Leave blank in dev; upload/playback endpoints will 503 cleanly.
AWS_REGION=us-east-1
AWS_S3_BUCKET=quipp-videos-prod
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Anthropic (Claude) for QUIPPY Equipment Consultant.
# Leave blank to disable QUIPPY; chat widget shows a "warming up" state.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# GreenAPI WhatsApp channel. The worker stays off unless enabled and all values are set.
GREEN_API_ENABLED=false
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
GREEN_API_API_URL=https://api.green-api.com
# A private bearer token you choose and also configure on the GreenAPI webhook.
GREEN_API_WEBHOOK_TOKEN=
